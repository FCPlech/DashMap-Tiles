{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DashMap-Tiles per-release manifest",
  "description": "release-manifest.json shipped as an asset inside every per-region GitHub Release. The app reads this to download + verify + unzip + install. Each dataset ships as one zip (split into .part-* when over GitHub's 2 GiB asset limit); the zip members carry the exact on-device filenames, so extraction goes straight into the install dir with no renaming.",
  "type": "object",
  "required": ["schema", "slug", "displayName", "tag", "builtAtMs", "source", "valhalla", "streets", "install", "attribution"],
  "properties": {
    "schema": { "const": 1 },
    "slug": { "type": "string" },
    "displayName": { "type": "string" },
    "tag": { "type": "string" },
    "builtAtMs": { "type": "integer" },
    "source": {
      "type": "object",
      "required": ["pbfFile", "sourceUrl"],
      "properties": {
        "pbfFile": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "valhallaVersion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "valhalla": {
      "type": "object",
      "required": ["present", "packaging", "archive", "files", "contents"],
      "properties": {
        "present": { "type": "boolean" },
        "packaging": { "enum": ["single", "split"] },
        "archive": {
          "type": "string",
          "pattern": "^[^/]+\\.zip$",
          "description": "Dataset zip basename (valhalla.zip); split parts are <archive>.part-aa, ..."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "size", "sha256"],
            "properties": {
              "name": { "type": "string" },
              "size": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "contents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Exact member names inside the zip (on-device filenames)."
        }
      },
      "additionalProperties": false
    },
    "streets": {
      "type": "object",
      "required": ["present", "packaging", "archive", "files", "contents"],
      "properties": {
        "present": { "type": "boolean" },
        "packaging": { "enum": ["single", "split"] },
        "archive": {
          "type": "string",
          "pattern": "^[^/]+\\.zip$",
          "description": "Dataset zip basename (streets.zip); split parts are <archive>.part-aa, ..."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "size", "sha256"],
            "properties": {
              "name": { "type": "string" },
              "size": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "contents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Exact member names inside the zip (on-device filenames)."
        }
      },
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "description": "Fixed on-device locations the app extracts each zip into.",
      "required": ["valhallaDir", "streetsDir"],
      "properties": {
        "valhallaDir": { "type": "string" },
        "streetsDir": { "type": "string" }
      },
      "additionalProperties": false
    },
    "attribution": { "type": "string" }
  },
  "additionalProperties": false
}
